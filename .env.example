# Copy this file to .env for local development
# In Railway, set these as environment variables in the dashboard

# Slack Bot Token (starts with xoxb-)
# Required scopes: channels:history, channels:read, groups:history, groups:read
SLACK_BOT_TOKEN=xoxb-your-token-here

# Intercom Access Token
# Create at: https://app.intercom.com/a/apps/_/settings/api-keys
INTERCOM_ACCESS_TOKEN=your-intercom-token-here
